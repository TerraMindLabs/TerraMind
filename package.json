{
  "name": "terramind",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @terramind/server\" \"npm run dev -w @terramind/web\"",
    "build": "npm run build --workspaces",
    "backend": "node apps/server/dist/server.js",
    "frontend": "npm run build -w @terramind/web",
    "start": "node apps/server/dist/server.js"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  },
  "description": "Welcome to **AutoDevOps AI**, your dedicated, self-correcting AI Cloud Architect. This package installs a private, containerized AI agent that writes, formats, secures, and automatically validates Terraform code against your cloud infrastructure.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerraMindLabs/TerraMind.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/TerraMindLabs/TerraMind/issues"
  },
  "homepage": "https://github.com/TerraMindLabs/TerraMind#readme"
}
